APP_ENV=local
APP_NAME=OfficeOS API
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/officeos
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
JWT_ALGORITHMS=["ES256"]
AUTH_REQUIRED=true
SUPABASE_ANON_KEY=
DOCUMENTS_STORAGE_BUCKET=documents
DOCUMENT_DOWNLOAD_EXPIRES_IN=300
DOCUMENT_UPLOAD_EXPIRES_IN=900

# Gmail SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_NAME=OfficeOS Notifications
EMAIL_FROM_ADDRESS=
EMAIL_ENABLED=true
FRONTEND_BASE_URL=http://localhost:3000
