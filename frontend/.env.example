# ==============================================================================
# OfficeOS Frontend Environment Configuration
# ==============================================================================
# NOTE: Only public, client-safe variables (prefixed with NEXT_PUBLIC_) belong here.
# NEVER place backend service-role keys, database passwords, or private secrets in this file.
# ==============================================================================

# Supabase Auth Configuration (Client-safe anonymous keys only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# FastAPI Backend Base URL (Standard OfficeOS v1 API prefix)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Frontend Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
